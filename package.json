{
  "name": "bld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "BLD",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w @bld/ui",
    "build": "npm run build -w @bld/ui",
    "preview": "npm run preview -w @bld/ui",
    "preview:e2e": "npm run preview:e2e -w @bld/ui",
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @bld/ui"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@types/node": "^26.4.0"
  }
}
