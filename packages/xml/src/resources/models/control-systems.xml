<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="blocks.xsd">
  <namespace id="com.dauch.cs" name="Control Systems"/>
  <namespace id="com.dauch.cs.gen" name="Gen" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.tf" name="Transform" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.sink" name="Sink" parent="com.dauch.cs"/>

  <block id="timer" name="Timer" ns="com.dauch.cs.gen" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Accepts (Double) -&gt; Unit and writes timestamps while running.</attribute>
    <factory id="timer"/>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="(Double) -> Unit"/>
  </block>

  <block id="random" name="Random" ns="com.dauch.cs.gen" icon="random">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Writes a random sample in [0, 1) at the quantization period.</attribute>
    <factory id="random"/>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="(Double) -> Unit"/>
  </block>

  <block id="sin" name="Sin" ns="com.dauch.cs.tf" icon="sin">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Transformer. Maps each sample with sin. (Double) -&gt; Unit → (Double) -&gt; Unit.</attribute>
    <factory id="sin"/>
    <in name="in" type="(Double) -> Unit"/>
    <out name="out" type="(Double) -> Unit"/>
  </block>

  <block id="cos" name="Cos" ns="com.dauch.cs.tf" icon="cos">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Transformer. Maps each sample with cos. (Double) -&gt; Unit → (Double) -&gt; Unit.</attribute>
    <factory id="cos"/>
    <in name="in" type="(Double) -> Unit"/>
    <out name="out" type="(Double) -> Unit"/>
  </block>

  <block id="scope" name="Scope" ns="com.dauch.cs.sink" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Plot sink. Returns a dynamically sized Array[(Double) -&gt; Unit]. Wire into a transformer or generator. After Run, Chart is a multi-axis plot.</attribute>
    <factory id="scope"/>
    <out name="out" type="Array[(Double) -> Unit]">
      <attribute name="dynamic">true</attribute>
    </out>
  </block>
</blocks>
