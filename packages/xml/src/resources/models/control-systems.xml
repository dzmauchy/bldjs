<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="blocks.xsd">
  <namespace id="com.dauch.cs" name="Control Systems"/>
  <namespace id="com.dauch.cs.gen" name="Gen" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.sink" name="Sink" parent="com.dauch.cs"/>

  <!--
    Pure push. Every generator is c<f64> → void:

      timer(c) / sin(c) / cos(c) / random(c)  : c<f64> → void
      scope()                                    : c<f64>[]          (vector of plot sinks)

    Composition: sin(plot[0])

    Each generator uses an internal quantizer. The period input (ms) is an
    integer range control, default 10 ms.

    Each <in> / <out> is the WASM signature for that block. Arrays are
    dynamically sized from the number of outgoing connectors.

    Each block is a binaryen.js script in src/lib/resources/binaryen/blocks.
    SolutionBuilder wires those scripts from the connected SolutionView.
    Every function receives runtime $ctx (i32 pointer: time, delay_ns).
  -->

  <block id="timer" name="Timer" ns="com.dauch.cs.gen" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Accepts c&lt;f64&gt; and writes timestamps while running.</attribute>
    <factory id="timer"/>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="c1">
      <t type="f64"/>
    </in>
  </block>

  <block id="sin" name="Sin" ns="com.dauch.cs.gen" icon="sin">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Writes sin(time) at the quantization period.</attribute>
    <factory id="sin"/>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="c1">
      <t type="f64"/>
    </in>
  </block>

  <block id="cos" name="Cos" ns="com.dauch.cs.gen" icon="cos">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Writes cos(time) at the quantization period.</attribute>
    <factory id="cos"/>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="c1">
      <t type="f64"/>
    </in>
  </block>

  <block id="random" name="Random" ns="com.dauch.cs.gen" icon="random">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Writes a random sample in [0, 1) at the quantization period.</attribute>
    <factory id="random"/>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="c1">
      <t type="f64"/>
    </in>
  </block>

  <block id="scope" name="Scope" ns="com.dauch.cs.sink" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Plot sink. Returns a dynamically sized vector of c&lt;f64&gt;. Wire into a generator. After Run, Chart is a multi-axis plot.</attribute>
    <factory id="scope"/>
    <out name="out" type="[]">
      <attribute name="dynamic">true</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </out>
  </block>
</blocks>
