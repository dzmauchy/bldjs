<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="blocks.xsd">
  <namespace id="com.dauch.cs" name="Control Systems"/>
  <namespace id="com.dauch.cs.gen" name="Gen" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.gpio" name="GPIO" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.tf" name="Transform" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.sink" name="Sink" parent="com.dauch.cs"/>

  <block id="timer" name="Timer" ns="com.dauch.cs.gen" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Accepts (double) -&gt; unit and writes timestamps while running.</attribute>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="(double) -> unit"/>
  </block>

  <block id="random" name="Random" ns="com.dauch.cs.gen" icon="random">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Writes a random sample in [0, 1) at the quantization period.</attribute>
    <parameters>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="(double) -> unit"/>
  </block>

  <block id="constant" name="Constant" ns="com.dauch.cs.gen" icon="constant">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Writes a constant sample at the quantization period.</attribute>
    <parameters>
      <double-range-parameter name="value" description="Constant sample value" min="-100" max="100" step="0.1" default="1"/>
      <integer-range-parameter name="period" description="Quantization period in milliseconds" min="1" max="1000" step="1" default="10"/>
    </parameters>
    <in name="in" type="(double) -> unit"/>
  </block>

  <block id="sin" name="Sin" ns="com.dauch.cs.tf" icon="sin">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Transformer. Maps each sample with sin. (double) -&gt; unit → (double) -&gt; unit.</attribute>
    <in name="in" type="(double) -> unit"/>
    <out name="out" type="(double) -> unit"/>
  </block>

  <block id="cos" name="Cos" ns="com.dauch.cs.tf" icon="cos">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Transformer. Maps each sample with cos. (double) -&gt; unit → (double) -&gt; unit.</attribute>
    <in name="in" type="(double) -> unit"/>
    <out name="out" type="(double) -> unit"/>
  </block>

  <block id="overshoot" name="Overshoot" ns="com.dauch.cs.tf" icon="overshoot">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Transformer. Maps time samples through a classic second-order underdamped unit-step response with damping ratio ζ and natural frequency ω. Damped frequency is ωd = ω√(1−ζ²). (double) -&gt; unit → (double) -&gt; unit.</attribute>
    <parameters>
      <double-range-parameter name="ζ" description="Damping ratio ζ" min="0.05" max="0.95" step="0.01" default="0.5"/>
      <double-range-parameter name="ω" description="Natural frequency ω (rad/s)" min="0.1" max="20" step="0.1" default="1"/>
    </parameters>
    <in name="in" type="(double) -> unit"/>
    <out name="out" type="(double) -> unit"/>
  </block>

  <block id="product" name="Product" ns="com.dauch.cs.tf" icon="product">
    <attribute name="kind">Process</attribute>
    <attribute name="combiner">true</attribute>
    <attribute name="description">Combiner. Returns n factor consumers. Each factor updates its slot and pushes the product of all slots into the downstream consumer. Unwired slots stay at def. (double) -&gt; unit → array[(double) -&gt; unit].</attribute>
    <parameters>
      <integer-range-parameter name="n" description="Output count" min="1" max="8" step="1" default="2"/>
      <double-range-parameter name="def" description="Default value of each output" min="-100" max="100" step="0.1" default="1"/>
    </parameters>
    <in name="in" type="(double) -> unit"/>
    <out name="out" type="array[(double) -> unit]">
      <attribute name="dynamic">true</attribute>
    </out>
  </block>

  <block id="gpio_in" name="GPIO In" ns="com.dauch.cs.gpio" icon="gpio_in">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Digital input. Pushes the pin level (0 or 1) when the pin changes. In the browser, toggling the switch emits one sample.</attribute>
    <parameters>
      <integer-range-parameter name="pin" description="GPIO pin number" min="0" max="31" step="1" default="0"/>
    </parameters>
    <in name="in" type="(double) -&gt; unit"/>
  </block>

  <block id="gpio_out" name="GPIO Out" ns="com.dauch.cs.gpio" icon="gpio_out">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Digital output. Consumes each sample and writes the pin (HIGH when the value is greater than 0.5). In the browser, the switch is a disabled readout of the pin.</attribute>
    <parameters>
      <integer-range-parameter name="pin" description="GPIO pin number" min="0" max="31" step="1" default="1"/>
    </parameters>
    <out name="out" type="(double) -&gt; unit"/>
  </block>

  <block id="scope" name="Scope" ns="com.dauch.cs.sink" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Plot sink. Returns a dynamically sized array[(double) -&gt; unit]. Wire into a transformer or generator. After Run, Chart is a sliding multi-axis plot of finite samples.</attribute>
    <parameters>
      <integer-range-parameter name="n" description="Time window width in seconds" min="10" max="600" step="1" default="30"/>
      <integer-range-parameter name="m" description="Quantizer period in milliseconds" min="10" max="1000" step="1" default="10"/>
    </parameters>
    <out name="out" type="array[(double) -> unit]">
      <attribute name="dynamic">true</attribute>
    </out>
  </block>
</blocks>
