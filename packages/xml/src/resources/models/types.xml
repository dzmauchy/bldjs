<?xml version="1.0" encoding="UTF-8"?>
<types id="types" name="Types" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="types.xsd">
  <namespace id="types" name="Types"/>

  <!-- Primitive Types -->
  <type name="bool"/>
  <type name="u64"/>
  <type name="u32"/>
  <type name="i64"/>
  <type name="i32"/>
  <type name="f32"/>
  <type name="f64"/>
  <type name="char"/>
  <type name="void"/>


  <!-- Built-in Generic Container -->
  <type name="Array">
    <var name="T"/>
  </type>

  <!-- Function / Consumer Types -->
  <type name="c0">
    <alias type="() -> void"/>
  </type>
  <type name="c1">
    <var name="T"/>
    <alias type="(T) -> void"/>
  </type>
  <type name="c2">
    <var name="T1"/>
    <var name="T2"/>
    <alias type="(T1, T2) -> void"/>
  </type>
  <type name="f0">
    <var name="R"/>
    <alias type="() -> R"/>
  </type>
  <type name="f1">
    <var name="T"/>
    <var name="R"/>
    <alias type="(T) -> R"/>
  </type>
  <type name="f2">
    <var name="T1"/>
    <var name="T2"/>
    <var name="R"/>
    <alias type="(T1, T2) -> R"/>
  </type>
</types>
