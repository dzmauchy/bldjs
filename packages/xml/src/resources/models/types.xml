<?xml version="1.0" encoding="UTF-8"?>
<blocks id="types" name="Types" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="blocks.xsd">
  <namespace id="types" name="Types"/>

  <!--
    Catalog types are camelCase. MoonBit emit maps them:

      double → Double → wasm f64
      float  → Float  → wasm f32
      int    → Int    → wasm i32
      int64  → Int64  → wasm i64
      string → String → wasm js-string (wasm 3.0)
      bool   → Bool   → wasm i32
      unit   → Unit
      array[T]
      (T) -> R
  -->

  <type name="double"/>
  <type name="float"/>
  <type name="int"/>
  <type name="int64"/>
  <type name="string"/>
  <type name="bool"/>
  <type name="unit"/>
  <type name="array">
    <var>T</var>
  </type>
</blocks>
