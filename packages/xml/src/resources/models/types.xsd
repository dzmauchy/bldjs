<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Primitive and Built-in Types -->
  <xs:simpleType name="PrimitiveType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bool"/>
      <xs:enumeration value="u64"/>
      <xs:enumeration value="u32"/>
      <xs:enumeration value="i64"/>
      <xs:enumeration value="i32"/>
      <xs:enumeration value="f32"/>
      <xs:enumeration value="f64"/>
      <xs:enumeration value="char"/>
      <xs:enumeration value="void"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Built-in Generic Container Types -->
  <xs:simpleType name="BuiltinContainerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Array"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Special Type Identifiers -->
  <xs:simpleType name="SpecialType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Self"/>
      <xs:enumeration value="_"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Type Expression Kinds -->
  <xs:simpleType name="TypeKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="type"/>
      <xs:enumeration value="func"/>
      <xs:enumeration value="tuple"/>
      <xs:enumeration value="array"/>
      <xs:enumeration value="union"/>
      <xs:enumeration value="intersection"/>
      <xs:enumeration value="hole"/>
      <xs:enumeration value="self"/>
      <xs:enumeration value="wildcard"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Variance for Wildcard Types -->
  <xs:simpleType name="VarianceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="+"/>
      <xs:enumeration value="-"/>
      <xs:enumeration value="="/>
      <xs:enumeration value="?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Type Reference String (Primitive, Special, Container, or Type String) -->
  <xs:simpleType name="TypeString">
    <xs:union memberTypes="PrimitiveType BuiltinContainerType SpecialType xs:string"/>
  </xs:simpleType>

  <!-- Custom Attribute Definition -->
  <xs:complexType name="AttributeDef" mixed="true">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Type Reference (`f64`, `(f64) -> void`, `Animal<X>`) -->
  <xs:complexType name="TypeRef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="TypeString"/>
    <xs:attribute name="name" type="xs:string"/>
  </xs:complexType>

  <!-- Type Variable with Constraints (extends ...) - NO variance! -->
  <xs:complexType name="TypeVarDef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="extends" type="TypeRef" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="extends" type="xs:string"/>
  </xs:complexType>

  <!-- Backward-compatible TypeParamDef -->
  <xs:complexType name="TypeParamDef">
    <xs:complexContent>
      <xs:extension base="TypeVarDef"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- Structured Block Type Variable Reference (<var name="T"/>) -->
  <xs:complexType name="TypeVarRef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Structured Raw Type Reference (<raw-type name="Animal"/>) -->
  <xs:complexType name="RawTypeRef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="ns" type="xs:string"/>
  </xs:complexType>

  <!-- Wildcard Type with Variance (only wildcards have variance!) -->
  <xs:complexType name="WildcardTypeDef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0">
        <xs:element name="extends" type="PortTypeRef"/>
        <xs:element name="super" type="PortTypeRef"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="variance" type="VarianceType"/>
    <xs:attribute name="extends" type="xs:string"/>
    <xs:attribute name="super" type="xs:string"/>
  </xs:complexType>

  <!-- Structured Intersection Type Definition -->
  <xs:complexType name="IntersectionTypeDef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="1" maxOccurs="unbounded">
        <xs:element name="type" type="PortTypeRef"/>
        <xs:element name="var" type="TypeVarRef"/>
        <xs:element name="raw-type" type="RawTypeRef"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <!-- Parameterized or Structured Port Type Reference -->
  <xs:complexType name="PortTypeRef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="type" type="PortTypeRef"/>
        <xs:element name="var" type="TypeVarRef"/>
        <xs:element name="raw-type" type="RawTypeRef"/>
        <xs:element name="wildcard" type="WildcardTypeDef"/>
        <xs:element name="intersection" type="IntersectionTypeDef"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="ns" type="xs:string"/>
    <xs:attribute name="type" type="TypeString"/>
  </xs:complexType>

  <!-- Namespace Definition -->
  <xs:complexType name="NamespaceDef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="parent" type="xs:string"/>
    <xs:attribute name="icon" type="xs:string"/>
  </xs:complexType>

  <!-- Type Definition: raw types or parameterized types with type variables with constraints -->
  <xs:complexType name="TypeDef">
    <xs:sequence>
      <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="var" type="TypeVarDef"/>
        <xs:element name="param" type="TypeVarDef"/>
      </xs:choice>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="extends" type="TypeRef"/>
        <xs:element name="ancestor" type="TypeRef"/>
      </xs:choice>
      <xs:element name="alias" type="TypeRef" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="ns" type="xs:string"/>
    <xs:attribute name="extends" type="xs:string"/>
  </xs:complexType>

  <!-- ROOT ELEMENT FOR TYPES CATALOG -->
  <xs:element name="types">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="attribute" type="AttributeDef" minOccurs="0" maxOccurs="unbounded"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="namespace" type="NamespaceDef"/>
          <xs:element name="type" type="TypeDef"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="icon" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Element definitions for standalone use or schema references -->
  <xs:element name="type" type="TypeDef"/>
  <xs:element name="namespace" type="NamespaceDef"/>

</xs:schema>
