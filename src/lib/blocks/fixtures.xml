<?xml version="1.0" encoding="UTF-8"?>
<blocks id="fixtures" name="Test Fixtures" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../resources/models/blocks.xsd">
  <namespace id="types" name="Types"/>
  <namespace id="flow" name="Flow"/>

  <block id="b_i32" name="i32" ns="types" icon="i32">
    <attribute name="kind">Data</attribute>
    <out name="value" type="i32"/>
  </block>

  <block id="b_i64" name="i64" ns="types" icon="i64">
    <attribute name="kind">Data</attribute>
    <out name="value" type="i64"/>
  </block>

  <block id="b_f32" name="f32" ns="types" icon="f32">
    <attribute name="kind">Data</attribute>
    <out name="value" type="f32"/>
  </block>

  <block id="b_f64" name="f64" ns="types" icon="f64">
    <attribute name="kind">Data</attribute>
    <out name="value" type="f64"/>
  </block>

  <block id="b_str" name="str" ns="types" icon="string">
    <attribute name="kind">Data</attribute>
    <out name="value" type="str"/>
  </block>

  <block id="b_bool" name="bool" ns="types" icon="bool">
    <attribute name="kind">Data</attribute>
    <out name="value" type="bool"/>
  </block>

  <block id="b_array_of" name="array" ns="types" icon="list">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Vararg elements become T[]</attribute>
    <param name="T"/>
    <factory id="array#of">
      <t type="T"/>
    </factory>
    <in name="elems" type="T" vararg="true"/>
    <out name="result" type="[]">
      <t type="T"/>
    </out>
  </block>

  <block id="b_array_get" name="array.get" ns="types" icon="list">
    <attribute name="kind">Process</attribute>
    <param name="T"/>
    <factory id="array#get">
      <t type="T"/>
    </factory>
    <in name="array" type="[]">
      <t type="T"/>
    </in>
    <in name="index" type="i32"/>
    <out name="elem" type="T"/>
  </block>

  <block id="b_start" name="Start" ns="flow" icon="start">
    <attribute name="kind">Start</attribute>
    <attribute name="description">Entry point for a flow</attribute>
    <param name="T"/>
    <out name="out" type="T"/>
  </block>

  <block id="b_process" name="Process" ns="flow" icon="process">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Do some work</attribute>
    <param name="T"/>
    <in name="in" type="T"/>
    <out name="out" type="T"/>
  </block>

  <block id="b_decision" name="Decision" ns="flow" icon="decision">
    <attribute name="kind">Decision</attribute>
    <attribute name="description">Branch on a condition</attribute>
    <param name="T"/>
    <in name="in" type="T"/>
    <out name="true" type="T"/>
    <out name="false" type="T"/>
  </block>

  <block id="b_data" name="Data" ns="flow" icon="data">
    <attribute name="kind">Data</attribute>
    <attribute name="description">Read or write data</attribute>
    <param name="T"/>
    <in name="in" type="T"/>
    <out name="out" type="T"/>
  </block>

  <block id="b_output" name="Output" ns="flow" icon="output">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Emit a result</attribute>
    <param name="T"/>
    <in name="in" type="T"/>
  </block>

  <block id="b_identity" name="Identity" ns="flow" icon="identity">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Pass a value through, unifying T</attribute>
    <param name="T"/>
    <in name="in" type="T"/>
    <out name="out" type="T"/>
  </block>
</blocks>
