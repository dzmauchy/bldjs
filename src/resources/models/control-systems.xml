<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems">
  <library id="wasm" name="WebAssembly"/>
  <namespace id="cs" name="Control Systems"/>

  <!--
    Connected blocks are nested WASM typed functions, not an f64 sample bus:

      oscilloscope(sin(quantizer(timer())))

    timer()      : func<func<func<f64>>>   — (func (param (ref $fn_fn_f64)))
    quantizer(_) : func<func<f64>>         — (func (param (ref $fn_f64)))
    sin(_)       : func<f64>               — (func (param f64))
    oscilloscope : func<f64> → void

    Compact display: fn<fn<fn<f64>>>
  -->

  <block id="timer" name="Timer" ns="cs" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Runnable time source. Returns func&lt;func&lt;func&lt;f64&gt;&gt;&gt; for quantizer(timer()).</attribute>
    <out name="out" type="func">
      <t type="func">
        <t type="func">
          <t type="f64"/>
        </t>
      </t>
    </out>
  </block>

  <block id="quantizer" name="Quantizer" ns="cs" icon="quantizer">
    <attribute name="kind">Process</attribute>
    <attribute name="description">func&lt;func&lt;func&lt;f64&gt;&gt;&gt; → func&lt;func&lt;f64&gt;&gt;. Parks 10 ms per sample.</attribute>
    <in name="in" type="func">
      <t type="func">
        <t type="func">
          <t type="f64"/>
        </t>
      </t>
    </in>
    <out name="out" type="func">
      <t type="func">
        <t type="f64"/>
      </t>
    </out>
  </block>

  <block id="sin" name="Sin" ns="cs" icon="sin">
    <attribute name="kind">Process</attribute>
    <attribute name="description">func&lt;func&lt;f64&gt;&gt; → func&lt;f64&gt;. Maps each sample through f64.sin (host).</attribute>
    <in name="in" type="func">
      <t type="func">
        <t type="f64"/>
      </t>
    </in>
    <out name="out" type="func">
      <t type="f64"/>
    </out>
  </block>

  <block id="oscilloscope" name="Oscilloscope" ns="cs" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Consumes func&lt;f64&gt; and plots samples. After Run, click Chart for a live view.</attribute>
    <in name="in" type="func">
      <t type="f64"/>
    </in>
  </block>
</blocks>
