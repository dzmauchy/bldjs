<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="blocks.xsd">
  <library id="types" name="Types"/>
  <namespace id="com.dauch.cs" name="Control Systems"/>
  <namespace id="com.dauch.cs.gen" name="Gen" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.transform" name="Transform" parent="com.dauch.cs"/>
  <namespace id="com.dauch.cs.sink" name="Sink" parent="com.dauch.cs"/>

  <!--
    Pure push. Every consumer is DoubleConsumer = c<f64>:

      timer(c)           : c<f64> → void
      quantizer(c)       : c<f64> → c<f64>
      sin(c) / cos(c)    : c<f64> → c<f64>
      oscilloscope()     : c<f64>[]          (vector of plot sinks)

    Composition: timer(sin(quantizer(plot[0])))

    The WASM runtime still lowers each sample port to first-order f64.

    Each block is a binaryen.js script in resources/binaryen/blocks.
    Run assembles those scripts and emits the module.
    Every function receives runtime $ctx (i32 pointer: time, delay_ns).
  -->

  <block id="timer" name="Timer" ns="com.dauch.cs.gen" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Push source. Accepts c&lt;f64&gt; and writes timestamps while running.</attribute>
    <factory id="timer"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </in>
  </block>

  <block id="quantizer" name="Quantizer" ns="com.dauch.cs" icon="quantizer">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;f64&gt; → c&lt;f64&gt;. Parks 10 ms per sample via memory.atomic.wait32.</attribute>
    <factory id="quantizer"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </in>
    <out name="out" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </out>
  </block>

  <block id="sin" name="Sin" ns="com.dauch.cs.transform" icon="sin">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;f64&gt; → c&lt;f64&gt;. Maps each sample through f64.sin (host).</attribute>
    <factory id="f64.sin"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </in>
    <out name="out" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </out>
  </block>

  <block id="cos" name="Cos" ns="com.dauch.cs.transform" icon="cos">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;f64&gt; → c&lt;f64&gt;. Maps each sample through f64.cos (host).</attribute>
    <factory id="f64.cos"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </in>
    <out name="out" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="f64"/>
    </out>
  </block>

  <block id="oscilloscope" name="Oscilloscope" ns="com.dauch.cs.sink" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Plot sink. Returns a vector of c&lt;f64&gt;. Wire into Sin/Cos/Quantizer, then into Timer. After Run, Chart is a multi-axis plot.</attribute>
    <factory id="oscilloscope"/>
    <out name="out" type="[]">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </out>
  </block>
</blocks>
