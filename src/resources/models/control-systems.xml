<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="blocks.xsd">
  <library id="types" name="Types"/>
  <namespace id="cs" name="Control Systems"/>

  <!--
    Ports are Consumer<DoubleConsumer> = c<c<f64>> (compact display writes c1 as c):

      timer()            : c<c<f64>>
      quantizer(c)       : c<c<f64>> → c<c<f64>>
      sin(c)             : c<c<f64>> → c<c<f64>>
      oscilloscope(c)    : c<c<f64>> → void   (c.accept(plot))

    Composition: sin(quantizer(period, timer(running))).accept(plot)

    The WASM runtime lowers each sample port to first-order f64
    (timer : s<f64>, quantizer/sin : f1<f64, f64>, oscilloscope : c1<f64>).

    Each block is a binaryen.js script in resources/binaryen/blocks.
    Run assembles those scripts and emits the module.
    Every function receives runtime $ctx (i32 pointer: time, delay_ns).
  -->

  <block id="timer" name="Timer" ns="cs" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="generator">true</attribute>
    <attribute name="description">Runnable time source. Consumer&lt;DoubleConsumer&gt; — c&lt;c&lt;f64&gt;&gt;.</attribute>
    <factory id="timer"/>
    <out name="out" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </out>
  </block>

  <block id="quantizer" name="Quantizer" ns="cs" icon="quantizer">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;c&lt;f64&gt;&gt; → c&lt;c&lt;f64&gt;&gt;. Parks 10 ms per sample via memory.atomic.wait32.</attribute>
    <factory id="quantizer"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </in>
    <out name="out" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </out>
  </block>

  <block id="sin" name="Sin" ns="cs" icon="sin">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;c&lt;f64&gt;&gt; → c&lt;c&lt;f64&gt;&gt;. Maps each sample through f64.sin (host).</attribute>
    <factory id="f64.sin"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </in>
    <out name="out" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </out>
  </block>

  <block id="oscilloscope" name="Oscilloscope" ns="cs" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Accepts c&lt;c&lt;f64&gt;&gt; and plots samples (c.accept(plot)). After Run, click Chart.</attribute>
    <factory id="oscilloscope"/>
    <in name="in" type="c1">
      <attribute name="wasm">f64</attribute>
      <t type="c1">
        <t type="f64"/>
      </t>
    </in>
  </block>
</blocks>
