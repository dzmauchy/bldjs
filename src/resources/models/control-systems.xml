<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems">
  <library id="java.lang" name="Java Lang"/>
  <library id="java.util" name="Java Util"/>
  <namespace id="cs" name="Control Systems"/>

  <!-- Primitive double and boxed Double (java.lang.Double). -->
  <type name="double" ns="java.lang"/>

  <!--
    Connected blocks are Java expressions, not a Double sample bus:

      oscilloscope(sin(quantizer(timer())))

    Compact display (Consumer → c, Double → f64, DoubleConsumer → c<f64>):

      timer()      : c<c<c<f64>>>
      quantizer(_) : c<c<f64>>
      sin(_)       : c<f64>
      oscilloscope : c<f64> → void

    DoubleConsumer           = Consumer<Double>           = c<f64>
    Consumer<DoubleConsumer> = Consumer<Consumer<Double>> = c<c<f64>>
  -->
  <type name="DoubleConsumer" ns="java.util.function">
    <ancestor type="Consumer">
      <t type="Double"/>
    </ancestor>
  </type>

  <block id="timer" name="Timer" ns="cs" icon="timer.svg">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="description">Runnable time source. Returns c&lt;c&lt;c&lt;f64&gt;&gt;&gt; for quantizer(timer()).</attribute>
    <out name="out" type="Consumer">
      <t type="Consumer">
        <t type="Consumer">
          <t type="Double"/>
        </t>
      </t>
    </out>
  </block>

  <block id="quantizer" name="Quantizer" ns="cs" icon="quantizer.svg">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;c&lt;c&lt;f64&gt;&gt;&gt; → c&lt;c&lt;f64&gt;&gt;. Parks 10 ms (LockSupport.parkNanos) per sample.</attribute>
    <in name="in" type="Consumer">
      <t type="Consumer">
        <t type="Consumer">
          <t type="Double"/>
        </t>
      </t>
    </in>
    <out name="out" type="Consumer">
      <t type="Consumer">
        <t type="Double"/>
      </t>
    </out>
  </block>

  <block id="sin" name="Sin" ns="cs" icon="sin.svg">
    <attribute name="kind">Process</attribute>
    <attribute name="description">c&lt;c&lt;f64&gt;&gt; → c&lt;f64&gt;. Maps each sample through Math.sin.</attribute>
    <in name="in" type="Consumer">
      <t type="Consumer">
        <t type="Double"/>
      </t>
    </in>
    <out name="out" type="Consumer">
      <t type="Double"/>
    </out>
  </block>

  <block id="oscilloscope" name="Oscilloscope" ns="cs" icon="scope.svg">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Consumes c&lt;f64&gt; and plots samples. Click Chart for a live view.</attribute>
    <in name="in" type="Consumer">
      <t type="Double"/>
    </in>
  </block>
</blocks>
