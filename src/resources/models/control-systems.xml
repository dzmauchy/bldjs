<?xml version="1.0" encoding="UTF-8"?>
<blocks id="cs" name="Control Systems">
  <library id="java.lang" name="Java Lang"/>
  <library id="java.util" name="Java Util"/>
  <namespace id="cs" name="Control Systems"/>

  <!-- Primitive double and boxed Double (java.lang.Double). -->
  <type name="double" ns="java.lang"/>

  <!--
    Push chain (source → sink):
      Timer.out : Double
      Quantizer / Sin : Double → Double
      Oscilloscope.in : Double

    The timer pushes timestamps downstream. Processors map each sample and
    push to the next consumer. The oscilloscope is the terminal sink.
  -->
  <type name="DoubleConsumer" ns="java.util.function">
    <ancestor type="Consumer">
      <t type="Double"/>
    </ancestor>
  </type>

  <block id="timer" name="Timer" ns="cs" icon="timer">
    <attribute name="kind">Start</attribute>
    <attribute name="runnable">true</attribute>
    <attribute name="description">Runnable time source. Pushes timestamps downstream on its own interval.</attribute>
    <out name="out" type="Double"/>
  </block>

  <block id="quantizer" name="Quantizer" ns="cs" icon="quantizer">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Holds each pushed sample for 10 ms (LockSupport.parkNanos).</attribute>
    <in name="in" type="Double"/>
    <out name="out" type="Double"/>
  </block>

  <block id="sin" name="Sin" ns="cs" icon="sin">
    <attribute name="kind">Process</attribute>
    <attribute name="description">Pushes Math.sin of each sample.</attribute>
    <in name="in" type="Double"/>
    <out name="out" type="Double"/>
  </block>

  <block id="oscilloscope" name="Oscilloscope" ns="cs" icon="scope">
    <attribute name="kind">Output</attribute>
    <attribute name="description">Sink that plots pushed doubles. Click Chart for a live view.</attribute>
    <in name="in" type="Double"/>
  </block>
</blocks>
